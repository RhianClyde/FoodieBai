<?xml version="1.0" encoding="utf-8"?>
<!-- UI UPDATE v2: Saved fragment layout with refined header and empty state styling -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_screen"
    android:orientation="vertical">

    <!-- HEADER -->
    <!-- UI UPDATE v2: Spacing and typography hierarchy -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="22dp"
        android:layout_marginTop="28dp"
        android:text="Saved Favorites"
        android:textColor="@color/text_dark"
        android:textSize="26sp"
        android:textStyle="bold" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="22dp"
        android:layout_marginTop="4dp"
        android:text="Your favorite dishes in one place"
        android:textColor="@color/text_secondary"
        android:textSize="14sp" />

    <!-- EMPTY SAVED STATE -->
    <!-- UI UPDATE v2: Friendly empty state with heart emoji and line spacing -->
    <TextView
        android:id="@+id/tv_empty_saved"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="80dp"
        android:gravity="center"
        android:lineSpacingExtra="5dp"
        android:text="❤️\n\nNo saved favorites yet.\nTap the heart icon on any dish to save it!"
        android:textColor="@color/text_muted"
        android:textSize="15sp"
        android:visibility="gone" />

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rv_saved"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginHorizontal="10dp"
        android:layout_marginTop="16dp"
        android:clipToPadding="false"
        android:paddingBottom="24dp" />

</LinearLayout>
